BASE_URL=https://sitewatch.yourdomain.com
CHECK_INTERVAL_SECONDS=300
PRO_PRICE=£7/month

# Stripe (Dashboard > Payment Links; Developers > Webhooks)
STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PORTAL_LINK=https://billing.stripe.com/p/login/xxxx

# Email (e.g. Resend: smtp.resend.com / user "resend" / password = API key)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxxx
SMTP_FROM=SiteWatch <alerts@yourdomain.com>
