# Copy this file to ".env" and fill in your own values.
# Never share .env or upload it to GitHub - it holds your secret keys.

# Signs the login cookie. Any long random text; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Stripe dashboard -> Developers -> API keys (use the TEST key while building)
STRIPE_SECRET_KEY=sk_test_...
# Printed by: python setup_stripe.py
STRIPE_PRICE_ID=price_...
# Printed by: stripe listen --forward-to localhost:8000/stripe/webhook  (or from the dashboard once online)
STRIPE_WEBHOOK_SECRET=whsec_...

# Only needed once the app is online, e.g. https://myinvoiceapp.com
# BASE_URL=
